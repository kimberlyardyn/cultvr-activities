NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime
# Agent RAG embeddings — must output 1536 dims (matches workspace_chunks).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Agent background job (Vercel Cron → /api/agent/jobs). Vercel sends this as
# a Bearer token; the job also needs SUPABASE_SERVICE_ROLE_KEY above.
CRON_SECRET=

RESEND_API_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 — leave empty to disable tracking (e.g. in dev).
NEXT_PUBLIC_GA_ID=

VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
